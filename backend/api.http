### =========================================================================
### 🟢 BAB 1: REGISTRASI 3 AKUN UTAMA HOTEL (TANPA SEEDER & UJI KEAMANAN DTO)
### -> Langsung tekan Send Request berturutan untuk mencetak aktor-aktor hotelmu!
### =========================================================================

# 1.1 Bikin Akun Admin (Owner Hotel / Chief Concierge) via Rute Official
POST {{baseUrl}}/user/official
Content-Type: application/json

{
  "name": "admintel",
  "email": "admintel@ngotelin.com",
  "password": "12345678",
  "role": "admin"
}

###
# 1.2 Bikin Akun Staff (Receptionist & Housekeeping) via Rute Official
POST {{baseUrl}}/user/official
Content-Type: application/json

{
  "name": "hibban",
  "email": "hibban@ngotelin.com",
  "password": "staffpassword123",
  "role": "staff"
}

###
# 1.3 Bikin Akun Tamu Awam (Calon Pembeli) via Rute Publik
# -> Notice: Tidak perlu param 'role', otomatis diterapkan @default("user") oleh DB!
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "Andi",
  "email": "andi@ngotelin.com",
  "password": "12345678"
}
# 👆 SALIN "id" dari respons di atas, tempel ke variabel @userId di atas layar!

###
# 1.4 UJI KEAMANAN 1: Mass-Assignment Attack Protection di Rute Publik
# -> Hacker mencoba daftar lewat rute umum tapi memaksa isian "role": "admin".
# -> HASILNYA: Ditolak mentah 400 Bad Request
# Sebaiknya tidak role di sini, karena api publik defaultnya adalah user, jadinya kalau butuh admin/staff harus lewat rute official
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "Hacker Menyusup",
  "email": "hacker_iseng@ngotelin.com",
  "password": "hackedpassword123",
}

###
# 1.5 UJI KEAMANAN 2: Penolakan Pangkat Palsu di Rute Official
# -> Coba mendaftar rute bos (/user/official) tapi menyandarkan role "user" atau "supergod".
# -> HASILNYA: Ditolak mentah 400 Bad Request karena pengawaman @IsIn([Role.ADMIN, Role.STAFF])!
POST {{baseUrl}}/user/official
Content-Type: application/json

{
  "name": "Penyusup Ruang 3(izin admin)",
  "email": "penyusup3@ngotelin.com",
  "password": "12345678",
  "role": "admin"
}

###
# 1.6 Cek Seluruh Daftar Akun Terdaftar & Konfirmasi Role Mereka
# -> CUMA BOLEH DIAKSES ADMIN & STAFF
GET {{baseUrl}}/user
Authorization: Bearer {{adminToken}}

###
# 1.7 [UJI KEPEMILIKAN AKUN] Tamu Biasa Mencoba Melihat Daftar Seluruh User
# -> HASILNYA: 403 Forbidden (Hanya Admin & Staff yang boleh)
GET {{baseUrl}}/user
Authorization: Bearer {{userToken}}
###
# 1.8 [UJI KEPEMILIKAN AKUN] Tamu Biasa (Idham) Mencoba Mengedit Profil Admin
# -> HASILNYA: 403 Forbidden (Akses Ditolak! Anda tidak berhak memanipulasi profil orang lain.)
# -> Pastikan id di bawah ini diganti dengan ID Admin!
PATCH {{baseUrl}}/user/{{adminId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "Hacked by Idham"
}

###
# 1.9 [UJI KEPEMILIKAN AKUN] Tamu Biasa (Idham) Mengedit Profilnya Sendiri
# -> HASILNYA: Sukses 200 OK!
PATCH {{baseUrl}}/user/{{userId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "Somaduh"
}


### =========================================================================
### 🟡 BAB 2: LOGIN AKUN & SETUP TIKET TOKEN (HTTP-Only Cookie Check)
### -> Ambil masing-masing access_token & salin ke kotak variabel di atas!
### =========================================================================

# 2.1 Login Admin (Owner Hotel)
# -> Salin string "access_token" dari respons ini ke variabel @adminToken di paling atas!
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@ngotelin.com",
  "password": "12345678"
}

###
# 2.2 Login Staff (Housekeeping / Front Office)
# -> Salin string "access_token" dari respons ini ke variabel @staffToken di paling atas!
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "staff@ngotelin.com",
  "password": "staffpassword123"
}

###
# 2.3 Login Tamu Hotel (User Awam)
# -> Salin string "access_token" dari respons ini ke variabel @userToken di paling atas!
# -> INTIP PANEL HEADERS DI KANAN: Server resmi melampirkan "Set-Cookie: access_token=..." yang Anti-XSS!
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "mat@ngotelin.com",
  "password": "12345678"
}

###
# 2.4 Test Endpoint Logout (Untuk melihat penghapusan Cookie dari Browser)
POST {{baseUrl}}/auth/logout


### =========================================================================
### 🔵 BAB 3: PERSIAPAN MASTER KAMAR HOTEL & GALERI (Oleh Admin & Uji RBAC)
### -> Bukti arsitektur bahwa hanya Admin yang mampu mengatur master properti hotel!
### =========================================================================

# 3.1 [RBAC: ADMIN ONLY] Admin Membuat Kamar Deluxe 101
# -> Pasang token admin. Setelah berhasil, salin "id" kamar ke variabel @resourceId di atas!
# Sebaiknya menggunakan Postman, Karena ada field opsional yaitu foto, dan max 5 foto
POST {{baseUrl}}/resources
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Maniac Room",
  "type": "suite",
  "location": "Lantai 3",
  "capacity": 3,
  "price_per_night": 500000,
  "facilities": ["TV", "AC", "Wi-Fi", "Extra Bed"]
}
# 👆 SALIN ID DARI KAMAR INI KE VARIABEL @resourceId DI ATAS!

###
GET  {{baseUrl}}/resources/
Authorization: Bearer {{adminToken}}


###
# 3.2 [RBAC: ADMIN ONLY] Admin Membuat Kamar VVIP Penthouse 202
# -> Salin "id" kamar VVIP ke variabel @resourceIdVVIP di atas!
POST {{baseUrl}}/resources
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "VVIP Penthouse Suite 202",
  "type": "vvip",
  "location": "Lantai 10 (Rooftop View)",
  "capacity": 6,
  "price_per_night": 2000000,
  "facilities": ["Private Jacuzzi", "Private Elevator", "Butler Service 24/7", "AI Smart Concierge"]
}
# 👆 SALIN ID DARI KAMAR INI KE VARIABEL @resourceIdVVIP DI ATAS!

###
# 3.4 [PUBLIC ROUTE] Tamu Awam Mengecek Katalog Seluruh Kamar Hotel
GET {{baseUrl}}/resources?search=&location=lantai 1&type=

### Get Single Resource
GET {{baseUrl}}/resources/{{resourceId}}


