### =========================================
### 1. AUTHENTICATION
### =========================================

# Login (Pastikan email dan password sesuai database)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "gibran@mail.ngotel",
  "password": "11111111"
}

### =========================================
### 2. USERS
### =========================================

# Get All Users
GET {{baseUrl}}/user
# Authorization: Bearer {{token}}

###
# Get Single User by ID
GET {{baseUrl}}/user/{{userId}}

###
# Create New User
POST {{baseUrl}}/user
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "password123",
  "role": "user"
}

###
# Update User
PATCH {{baseUrl}}/user/{{userId}}
Content-Type: application/json

{
  "name": "John Doe Updated"
}

###
# Delete User
DELETE {{baseUrl}}/user/{{userId}}

### =========================================
### 3. RESOURCES (Fasilitas / Kamar)
### =========================================

### Create Resource (Bikin Kamar Baru)
POST {{baseUrl}}/resources
Content-Type: application/json

{
  "name": "Triple Room Luxury",
  "type": "standard",
  "location": "Lantai 1",
  "capacity": 3,
  "price_per_night": 500000,
  "facilities": ["TV", "AC", "Wi-Fi", "Extra Bed"]
}

### Resource Update
PATCH {{baseUrl}}/resources/{{resourceId}}
Content-Type: application/json

{
  "name": "Kamar Standard B"
}

### Resource Delete
DELETE {{baseUrl}}/resources/{{resourceId}}


### Get All Resources (Bisa ditambah filter: ?search=kamar&location=lantai1&type=vip)
GET {{baseUrl}}/resources?search=&location=&type=

### Get Single Resource
GET {{baseUrl}}/resources/{{resourceId}}


### =========================================
### 4. SCHEDULES (Jadwal)
### =========================================



# NEW SCHEDULE
# Create Schedule (Buat 1 Jadwal)
###
POST {{baseUrl}}/schedule
Content-Type: application/json

{
  "resource_id": "{{resourceId}}",
  "start_time": "2026-07-30T12:15:00.000Z",
  "end_time": "2026-07-30T14:30:00.000Z",
  "status": "maintenance"
}

# Create Batch (lewat semenit bisa di kasi aksi. jika jadwal available)
### 
POST {{baseUrl}}/schedule/batch
Content-Type: application/json

[
  {
    "resource_id": "{{resourceIdVVIP}}",
    "start_time": "2026-07-27T09:00:00.000Z",
    "end_time": "2026-07-28T12:00:00.000Z",
    "status": "maintenance"
  },
  {
    "resource_id": "{{resourceIdVVIP}}",
    "start_time": "2026-07-28T12:01:00.000Z",
    "end_time": "2026-07-29T12:00:00.000Z",
    "status": "booked"
  }
]

### Get Find All
GET {{baseUrl}}/schedule
Content-Type: application/json

### Find By Id
GET {{baseUrl}}/schedule/{{scheduleId}}
Content-Type: application/json

### Find Busy Schedule (check pada jam 12 siang tanggal 26, jika tidak ada respon "ce857014-f4a7-4e63-b9ea-1d1d44c43f56", maka dia menangkap yg benar booked/maintenece pada rentang waktu realtime() - dia mencatat tanggal yg masi belum di lewati
GET {{baseUrl}}/schedule/busy/{{resourceId}}
Content-Type: application/json

### Update Schedule (skenario ubah waktu boking)
PATCH {{baseUrl}}/schedule/{{scheduleId}}
Content-Type: application/json

{
  "start_time": "2026-07-27T09:00:00.000Z",
  "end_time": "2026-07-28T13:00:00.000Z"
}

### Update Schedule (skenario ubah status jadi canceled, karena available otomtis sesuai tenggat waktu) 
PATCH {{baseUrl}}/schedule/{{scheduleId}}
Content-Type: application/json

{
  "status": "canceled"
}

### Delete Schedule
DELETE {{baseUrl}}/schedule/{{scheduleId}}

### =========================================
### 5. BOOKINGS (Penyewaan)
### =========================================


### 1. CREATE BOOKING (Otomatis bikin Schedule & Payment)
POST {{baseUrl}}/bookings
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "resource_id": "{{resourceIdVVIP}}",
  "start_time": "2026-08-02T10:00:00Z",
  "end_time": "2026-08-04T12:00:00Z",
  "notes": "Nak Nginepv3",
  "payment_method": "qris" 
}
### Note payment_method sesuaikan dengan enum PaymentMethod lu (misal: 'transfer', 'cash', dll)

### 2. GET ALL BOOKINGS (Data lengkap + relasi)
GET {{baseUrl}}/bookings

### 3. GET BOOKINGS FILTER: ANTRIAN STAFF
GET {{baseUrl}}/bookings?status=pending

### 4. GET BOOKINGS FILTER: RIWAYAT USER TERTENTU
GET {{baseUrl}}/bookings?user_id={{userId}}

### 5. GET DETAIL BOOKING (By ID)
GET {{baseUrl}}/bookings/{{bookingId}}

### 6. UPDATE BOOKING: STAFF APPROVE
### (Otomatis melunaskan tabel payment)
PATCH {{baseUrl}}/bookings/{{bookingId}}
Content-Type: application/json

{
  "status": "approved",
  "notes": "Pembayaran telah dikonfirmasi oleh Admin"
}

### 7. UPDATE BOOKING: STAFF REJECT
### (Otomatis ubah schedule jadi CANCELED)
PATCH {{baseUrl}}/bookings/{{bookingId}}
Content-Type: application/json

{
  "status": "rejected",
  "notes": "Booking fiktif, user diblacklist"
}

### 8. UPDATE BOOKING: CHECK-IN / COMPLETED
PATCH {{baseUrl}}/bookings/{{bookingId}}
Content-Type: application/json

{
  "status": "approved",
  "notes": "Guest sudah check-out, kunci dikembalikan"
}

### 9. DELETE / CANCEL BOOKING (Oleh User/Staff)
### (Otomatis ubah schedule jadi CANCELED)
DELETE {{baseUrl}}/bookings/{{bookingId}}

