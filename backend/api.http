# NEW SCHEDULE
# Create Schedule (Buat 1 Jadwal)
###
# 3.5 [PUBLIC ROUTE] Tamu Mengecek Detail Ketersediaan Kamar by Rentang Tanggal
GET {{baseUrl}}/resources/available?checkIn=2026-08-01&checkOut=2026-08-05

###
# 3.6 [UJI MENTAL PENJAGA RBAC!] Tamu Awam Mencoba Menghasut & Merubah Harga Kamar
# -> Kita sengaja pasangkan {{userToken}} (token tamu) ke endpoint khusus Admin.
# -> HASILNYA: Satpam kita langsung membentengi rute dan menjawab "403 FORBIDDEN - Akses Ditolak!"
PATCH {{baseUrl}}/resources/{{resourceId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "price_per_night": 1000,
  "name": "Kamar Udah Gue Bajak Harganya"
}


### =========================================================================
### 🟣 BAB 4: PENGATURAN JADWAL OPERASIONAL & MAINTENANCE (Oleh Staff / Admin)
### -> Memperlihatkan sinergisitas tim teknisi kamar & penjagaan RBAC
### =========================================================================

# 4.1 [RBAC: STAFF & ADMIN ONLY] Housekeeping Mengunci Jadwal Kamar VVIP untuk Maintenance
# -> Staff berwenang mengunci kamar agar tidak ditawarkan oleh AI atau disewa tamu awam.
POST {{baseUrl}}/schedule
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "resource_id": "{{resourceId}}",
  "start_time": "2026-08-05T12:15:00.000Z",
  "end_time": "2026-08-05T14:00:00.000Z",
  "status": "maintenance"
}
# 👆 SALIN ID JADWAL INI KE VARIABEL @scheduleId DI ATAS!

###
# 4.2 [PUBLIC ROUTE] Kalender Frontend Cek Apakah Kamar VVIP Sedang Sibuk / Blocked
GET {{baseUrl}}/schedule/busy/{{resourceIdVVIP}}
Content-Type: application/json

###
# 4.3 [RBAC: STAFF ONLY] Staff Memperbarui Waktu Servis Kamar
PATCH {{baseUrl}}/schedule/{{scheduleId}}
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "end_time": "2026-07-29T20:00:00.000Z"
}

###
# 4.4 [UJI RBAC] Admin/Staff Ngecek Seluruh Log Jadwal Hotel
# -> HASILNYA: Sukses 200 OK (Menampilkan data log maintenance dan reservasi)
GET {{baseUrl}}/schedule
Authorization: Bearer {{staffToken}}

###
# 4.5 [UJI RBAC] Tamu Mencoba Mengintip Log Jadwal Internal Hotel
# -> HASILNYA: 403 Forbidden (Akses Ditolak! Rute ini barusan lu gembok khusus Admin/Staff)
GET {{baseUrl}}/schedule
Authorization: Bearer {{userToken}}


###
GET {{baseUrl}}/resources
Authorization: Bearer {{adminToken}}



### =========================================================================
### 🟠 BAB 5: PENYEWAAN KAMAR (BOOKING), DOUBLE-BOOKING PROTECTION & INVOICE
### -> Puncaknya di mana uang dan transaksi dikawal ketat oleh Atomic Database Transaction!
### =========================================================================

# 5.1 [TAMU LOGIN REQUIRED] Sultan Budi Memesan Kamar Deluxe 101 Selama 3 Malam
# -> OTOMATIS: Sistem mengalikan harga kamar (500.000 x 3 malam = 1.500.000) dan diset abadi di total_price.
# -> OTOMATIS: Terbuat 1 baris jadwal (Schedule) berstatus "booked" yang mengunci slot tanggal tersebut.
# -> OTOMATIS: Menerbitkan invoice pembayaran (Payment) di database berstatus "pending".
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "resource_id": "{{resourceId}}",
  "start_time": "2026-08-01T14:00:00Z",
  "end_time": "2026-08-04T12:00:00Z",
  "notes": "Tolong disiapkan welcome drink buah segar dan selimut tambahan ya Mba",
  "payment_method": "qris"
}
# 👆 SALIN "id" DARI BOOKING YANG TERCIERTA INI KE VARIABEL @bookingId DI ATAS!

###
# 5.2 [UJI KESAKTIAN ANTI DOUBLE-BOOKING!] Tamu Lain Mengklik Reservasi di Kamar & Jam yang Sama
# -> Silakan kamu tekan "Send Request" SEKALI LAGI di jam yang beririsan ini.
# -> HASILNYA SEKRUP ATOMIK TRANSAKSI BERJALAN: Sistem membalas "409 Conflict: Resource/Ruangan sudah dibooking pada jam tersebut!"
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "resource_id": "{{resourceId}}",
  "start_time": "2026-08-02T10:00:00Z",
  "end_time": "2026-08-03T12:00:00Z",
  "notes": "Saya juga mau pesan di tanggal yang sama dong!",
  "payment_method": "gopay"
}

###
# 5.3 [TAMU LOGIN REQUIRED] Sultan Budi Mengecek Rincian Pesanan dan Status Tagihannya
# -> Kamu akan melihat relasi tabel "payment: { amount: 1500000, status: 'pending' }" di balasan JSON
GET {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{userToken}}

###
# 5.4 [RBAC: ADMIN & STAFF] Mba Front Office Cek Antrian Bookingan Masalah Pending
GET {{baseUrl}}/bookings?status=pending
Authorization: Bearer {{staffToken}}

###
# 5.5 [RBAC: ADMIN & STAFF] KONFIRMASI PEMBAYARAN SUKSES (Manual Reconciliation)
# -> Kejaibannya: Ketika status bookingan diset jadi "approved", SISTEM OTOMATIS MERUBAH TABEL PAYMENT JADI "PAID" dan mencetak jam bayar!
PATCH {{baseUrl}}/bookings/{{bookingId}}
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "status": "approved",
  "notes": "Bukti QRIS 1.500.000 tervalidasi masuk akal. Kunci kamar 101 siap diberikan."
}

###
# 5.6 [TAMU LOGIN REQUIRED] Tamu Melihat Kuitansi Bukti Pembayaran Lunas
# -> Perhatikan bagian payment di JSON response: "status: 'paid'" dan "paid_at: <Waktu_Sekarang>"
GET {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{userToken}}

###
# 5.7 [RBAC: ADMIN & STAFF] Guest Check-Out (Selesai Menginap)
PATCH {{baseUrl}}/bookings/{{bookingId}}
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "status": "completed",
  "notes": "Tamu sudah checkout dengan rapi, kunci dikembalikan tanpa kerusakan."
}

###
# 5.8 [UJI BEST PRACTICE CORPO] Skenario Soft-Cancel / Batal Pesanan (Oleh Tamu)
# -> Catatan: Kita menekan DELETE pada rute ini BUKAN menghapus permanen dari DB (supaya audit laporan akuntansi tidak musnah / berlubang).
# -> EFEKNYA: Status pesanan berubah jadi "canceled", invoice gugur, dan slot jadwal hotel kembali "available"!
DELETE {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{userToken}}
